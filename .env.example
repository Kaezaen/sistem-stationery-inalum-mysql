APP_NAME="Sistem Stationery"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Bahasa & lokal Indonesia — memengaruhi format tanggal/angka dan pesan validasi
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database -------------------------------------------------------------
# MySQL 8.0.16+ WAJIB (engine InnoDB, charset utf8mb4). Versi < 8.0.16 dan MariaDB
# MENGABAIKAN CHECK constraint → jaring pengaman database jebol secara diam-diam.
# SQLite TIDAK memadai — lihat docs/development-setup.md dan spec §10.1.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=taajri_stationery
DB_USERNAME=taajri
DB_PASSWORD=

# Database terpisah untuk pengujian (dipakai phpunit.xml)
DB_TEST_DATABASE=taajri_stationery_test

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Driver database dipilih agar deployment non-Docker tidak perlu Redis (ADR-11)
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Email ----------------------------------------------------------------
# Produksi: SMTP internal Inalum. Lokal: 'log' menulis email ke storage/logs
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="stationery@inalum.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
